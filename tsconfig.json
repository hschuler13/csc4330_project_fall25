{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",

    "strict": true,
    "types": ["node"],

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // Optional: turn this OFF for simpler interop with CommonJS packages like express
    "verbatimModuleSyntax": false,

    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  }
}
